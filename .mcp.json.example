{
  "_comment": "Copy this file to .mcp.json and replace <PLAINTEXT_KEY> with a real key (Settings → MCP Keys at https://www.cardmem.com or the cardmem_generate_mcp_key MCP tool). .mcp.json is gitignored — never commit your key. Native HTTP transport (not the npx mcp-remote bridge, which timed out the fleet on OAuth-discovery). cardmem-lens runs the Lens stdio proxy (lens-mcp) in front of the LOCAL daemon (loopback, no auth) that owns the browser for lens_* tools — it survives a daemon restart without a /mcp reconnect.",
  "mcpServers": {
    "cardmem": {
      "type": "http",
      "url": "https://services.cardmem.com/mcp",
      "headers": {
        "Authorization": "Bearer <PLAINTEXT_KEY>"
      }
    },
    "cardmem-lens": {
      "command": "npx",
      "args": [
        "-y",
        "--prefer-online",
        "-p",
        "@broberg/lens-client@0.2.0",
        "lens-mcp"
      ],
      "env": {
        "LENS_MCP_URL": "http://127.0.0.1:7475/mcp"
      }
    }
  }
}
